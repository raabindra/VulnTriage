FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key

DATABASE_URL=postgresql://postgres:password@localhost:5432/vuln_triage_db

UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800

NVD_API_KEY=your-nvd-api-key-here
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# Nessus (optional — enables the Nessus scanner in Auto Scan).
# Generate the key pair in the Nessus web UI: avatar (top-right) -> Settings/My
# Account -> API Keys -> Generate. Copy both values (shown once). Put them in a
# real backend/.env (git-ignored) — never commit them.
NESSUS_URL=https://localhost:8834
NESSUS_ACCESS_KEY=your-nessus-access-key
NESSUS_SECRET_KEY=your-nessus-secret-key
